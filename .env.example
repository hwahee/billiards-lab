# ============================================================================
# Environment template — copy to `.env` (or `.env.local`) and fill in values.
# Real secrets must NEVER be committed; `.env*` files are gitignored.
#
# Switching between local / development / production requires NO code change:
# only this file (or the environment variables of the deployment) changes.
# ============================================================================

# local | development | production
APP_ENV=local

# HTTP port the server listens on.
PORT=3000

# --- Database -----------------------------------------------------------------
# Driver: `postgres` (default) or `memory` (no external dependency; useful for
# quick local hacking and used automatically by the test suite).
DB_DRIVER=postgres
DATABASE_URL=postgres://app:app_local_password@localhost:5432/app

# Used by docker-compose to provision the Postgres container.
POSTGRES_USER=app
POSTGRES_PASSWORD=app_local_password
POSTGRES_DB=app
# Host port the container is published on. Projects run side by side locally
# (a service next to the member server) each need their own — change it here
# and in DATABASE_URL above together.
POSTGRES_PORT=5432

# --- CORS ---------------------------------------------------------------------
# Comma-separated list of allowed origins. Empty = same-origin only.
CORS_ORIGINS=http://localhost:3000

# --- Horizontal scaling --------------------------------------------------------
# Pub/sub driver used for cross-instance communication: `memory` | `redis`.
# `memory` only works within a single instance; switch to `redis` when running
# multiple instances behind a load balancer. Chat presence (who is in a room)
# follows the same setting and lives in Redis too.
PUBSUB_DRIVER=memory
# REDIS_URL=redis://localhost:6379

# Role of this process: `web` (HTTP only) | `worker` (background jobs only) | `all`.
SERVER_ROLE=all

# --- Graceful shutdown ----------------------------------------------------------
# How long to keep reporting "not ready" before closing the listener, so load
# balancers stop routing traffic to this instance first.
SHUTDOWN_DRAIN_MS=3000

# --- Sign-in --------------------------------------------------------------------
# `none` (default when unset): no sign-in at all, /api/auth is not mounted.
# `oidc`: members sign in on the member server (hwahee/boilerplate-auth), which
# must be running — locally too. The values below are this service's entry in
# the member server's services/local.json; a new service adds its own entry
# there (its id is its subdomain) and copies the same values here.
AUTH_DRIVER=oidc
OIDC_ISSUER=http://localhost:4444
OIDC_CLIENT_ID=boilerplate
OIDC_CLIENT_SECRET=local-only-boilerplate-client-secret
# Where browsers reach this service (the sign-in callback lives under it).
PUBLIC_URL=http://localhost:3000
# Signs the session cookie. At least 32 characters; a long random one outside
# local, e.g. `openssl rand -base64 48`.
SESSION_SECRET=local-only-session-secret-change-me-elsewhere
